{
  "name": "comfy-design",
  "displayName": "Comfy Design · ComfyUI Workflows",
  "displayName_i18n": {
    "en": "Comfy Design · ComfyUI Workflows"
  },
  "version": "0.5.0",
  "description": "Local-first ComfyUI workflows for images, video, audio and 3D. Partner models and uploads escalate to Comfy Cloud only when opted in.",
  "description_i18n": {
    "en": "Local-first ComfyUI workflows for images, video, audio and 3D. Partner models and uploads escalate to Comfy Cloud only when opted in."
  },
  "author": {
    "name": "Full Stack Skills / PartMe.AI",
    "url": "https://github.com/partme-ai"
  },
  "homepage": "https://github.com/full-aigc-plugins/comfy-design-plugin",
  "repository": "https://github.com/full-aigc-plugins/comfy-design-plugin",
  "license": "Apache-2.0",
  "keywords": [
    "comfy",
    "comfyui",
    "workflow"
  ],
  "skills": "skills",
  "commands": "commands",
  "mcpServers": {
    "comfy-mcp": {
      "command": "python3",
      "args": [
        "${ZCODE_PLUGIN_ROOT}/scripts/comfy_mcp_bootstrap.py"
      ],
      "cwd": "${ZCODE_PLUGIN_ROOT}",
      "timeoutMs": 60000
    },
    "comfy-cloud": {
      "type": "http",
      "url": "https://cloud.comfy.org/mcp",
      "headers": {
        "X-API-Key": "${user_config.comfy_api_key}"
      }
    }
  },
  "userConfig": {
    "comfy_api_key": {
      "type": "string",
      "title": "Comfy API Key",
      "description": "在 platform.comfy.org/profile/api-keys 创建（前缀 comfyui-）；留空则首次使用时走 OAuth 登录。",
      "required": false,
      "sensitive": true
    }
  }
}
