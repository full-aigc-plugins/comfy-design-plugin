{
  "name": "comfy-design",
  "version": "0.6.0",
  "description": "Generate images, video, audio, and 3D through a local ComfyUI MCP, with Comfy Cloud as an opt-in escalation for partner models and uploads.",
  "type": "module",
  "main": "lib/index.js",
  "icon": "./icon.png",
  "exports": {
    ".": "./lib/index.js",
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./locale/*": "./locale/*"
  },
  "files": [
    "cordis.patch.yml",
    "lib/index.js",
    "icon.svg",
    "icon.png",
    "README.md",
    "locale"
  ],
  "license": "Apache-2.0",
  "keywords": [
    "comfy",
    "comfyui",
    "text2image",
    "text2video",
    "workflow"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "private": true
}
