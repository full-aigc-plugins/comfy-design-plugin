{
  "name": "comfy-design",
  "version": "0.2.0",
  "description": "Generate images, video, audio, and 3D, search models and nodes, and run Comfy Cloud workflows through MCP.",
  "author": {
    "name": "Full Stack Skills / PartMe.AI"
  },
  "homepage": "https://github.com/full-aigc-plugins/comfy-design-plugin",
  "license": "Apache-2.0",
  "keywords": [
    "comfy",
    "comfyui",
    "workflow"
  ],
  "interface": {
    "displayName": "Comfy Design",
    "shortDescription": "Comfy Cloud generation workflows",
    "longDescription": "Operate Comfy Cloud from your coding agent: generate images, video, audio, and 3D, search models, nodes, and templates, and run ComfyUI workflows through the hosted Comfy MCP.",
    "developerName": "Full Stack Skills / PartMe.AI",
    "websiteURL": "https://github.com/full-aigc-plugins/comfy-design-plugin"
  },
  "skills": "./skills/",
  "commands": "./commands/",
  "mcpServers": {
    "comfy-cloud": {
      "url": "https://cloud.comfy.org/mcp",
      "bearerTokenEnvVar": "COMFY_API_KEY"
    }
  },
  "hooks": [
    {
      "event": "SessionStart",
      "command": "python3 ./hooks/env_check.py",
      "timeout": 30
    },
    {
      "event": "UserPromptSubmit",
      "command": "python3 ./hooks/check_comfy_intent.py",
      "timeout": 15
    }
  ]
}
