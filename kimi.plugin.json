{
  "name": "comfy-design",
  "version": "0.5.0",
  "description": "Generate images, video, audio, and 3D through a local ComfyUI MCP, with Comfy Cloud as an opt-in escalation for partner models and uploads.",
  "author": {
    "name": "Full Stack Skills / PartMe.AI"
  },
  "homepage": "https://github.com/full-aigc-plugins/comfy-design-plugin",
  "license": "Apache-2.0",
  "keywords": [
    "comfy",
    "comfyui",
    "workflow"
  ],
  "interface": {
    "displayName": "Comfy Design",
    "shortDescription": "Local-first ComfyUI generation workflows",
    "longDescription": "Generate images, video, audio, and 3D on your own GPU through the local ComfyUI MCP (comfy-mcp), and escalate to the hosted Comfy MCP (comfy-cloud) only for partner models and uploads.",
    "developerName": "Full Stack Skills / PartMe.AI",
    "websiteURL": "https://github.com/full-aigc-plugins/comfy-design-plugin"
  },
  "skills": "./skills/",
  "commands": "./commands/",
  "mcpServers": {
    "comfy-mcp": {
      "command": "python3",
      "args": [
        "./scripts/comfy_mcp_bootstrap.py"
      ]
    },
    "comfy-cloud": {
      "url": "https://cloud.comfy.org/mcp",
      "bearerTokenEnvVar": "COMFY_API_KEY"
    }
  },
  "hooks": [
    {
      "event": "SessionStart",
      "command": "python3 ./hooks/env_check.py",
      "timeout": 30
    },
    {
      "event": "UserPromptSubmit",
      "command": "python3 ./hooks/check_comfy_intent.py",
      "timeout": 15
    }
  ]
}
